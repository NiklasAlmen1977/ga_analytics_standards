	/// Base connection to the metric business definition list on the Group Analytics metadata SharePoint site.
	expression src_sharepoint_analytics_metric_business_definition =
			let
			    // ----------------------------------
			    // 1. Source
			    // ----------------------------------
			    // Connects to the configured SharePoint metadata site.
			    Source_SharePointTables =
			        SharePoint.Tables(
			            p_analytics_metadata_site_root_path,
			            [
			                Implementation = "2.0",
			                ViewMode = "All"
			            ]
			        ),
			
			    // ----------------------------------
			    // 2. Navigation
			    // ----------------------------------
			    // Navigates to the specific SharePoint list by list ID.
			    Navigation_MetricDefinitionsList =
			        Source_SharePointTables{[Id = "14e8500b-9d75-4c48-8304-bb039467ae06"]}[Items],
			
			    // ----------------------------------
			    // 3. Column selection
			    // ----------------------------------
			    // Keeps only business-relevant columns and removes SharePoint system metadata early.
			    Select_BusinessColumns =
			        Table.SelectColumns(
			            Navigation_MetricDefinitionsList,
			            {
			                "ID",
			                "Metric",
			                "Business definition",
			                "Why important/What decision does it drive",
			                "Formula",
			                "Owner",
			                "Domain",
			                "Target",
			                "Leading/Lagging",
			                "Direction of good performance",
			                "Frequency",
			                "Approval Status",
			                "Comment",
			                "Type of KPI",
			                "Unit of Measure"
			            },
			            MissingField.UseNull
			        ),
			
			    // ----------------------------------
			    // 4. Clean HTML text
			    // ----------------------------------
			    // Extracts plain text from the HTML-formatted Business definition column.
			    Add_BusinessDefinitionCleaned =
			        Table.AddColumn(
			            Select_BusinessColumns,
			            "Business definition Cleaned",
			            each
			                let
			                    // Read the original HTML/text value.
			                    HtmlValue = [Business definition],
			
			                    // Parse the HTML and extract the root text.
			                    ParsedHtml =
			                        try
			                            Html.Table(
			                                HtmlValue,
			                                {{"PlainText", ":root"}}
			                            )
			                        otherwise
			                            null,
			
			                    // Return the first extracted text value if available.
			                    ExtractedText =
			                        if ParsedHtml <> null and Table.RowCount(ParsedHtml) > 0 then
			                            ParsedHtml{0}[PlainText]
			                        else
			                            null,
			
			                    // Normalize non-breaking spaces and trim surrounding whitespace.
			                    CleanedText =
			                        if ExtractedText <> null then
			                            Text.Trim(
			                                Text.Replace(
			                                    ExtractedText,
			                                    Character.FromNumber(160),
			                                    " "
			                                )
			                            )
			                        else
			                            null
			                in
			                    CleanedText,
			            type text
			        ),
			
			    // ----------------------------------
			    // 5. Replace original business definition
			    // ----------------------------------
			    // Removes the original HTML column and keeps the cleaned plain-text version.
			    Remove_OriginalBusinessDefinition =
			        Table.RemoveColumns(
			            Add_BusinessDefinitionCleaned,
			            {"Business definition"}
			        ),
			
			    Rename_CleanedBusinessDefinition =
			        Table.RenameColumns(
			            Remove_OriginalBusinessDefinition,
			            {
			                {
			                    "Business definition Cleaned",
			                    "Business definition"
			                }
			            }
			        ),
			
			    // ----------------------------------
			    // 6. Final column order
			    // ----------------------------------
			    // Applies the preferred business glossary order.
			    Reorder_FinalColumns =
			        Table.ReorderColumns(
			            Rename_CleanedBusinessDefinition,
			            {
			                "ID",
			                "Metric",
			                "Business definition",
			                "Why important/What decision does it drive",
			                "Formula",
			                "Owner",
			                "Domain",
			                "Target",
			                "Leading/Lagging",
			                "Direction of good performance",
			                "Frequency",
			                "Approval Status",
			                "Comment",
			                "Type of KPI",
			                "Unit of Measure"
			            }
			        ),
			
			    // ----------------------------------
			    // 7. Data type conversion
			    // ----------------------------------
			    // Applies explicit data types after all structural transformations are complete.
			    Convert_DataTypes =
			        Table.TransformColumnTypes(
			            Reorder_FinalColumns,
			            {
			                {"ID", Int64.Type},
			                {"Metric", type text},
			                {"Business definition", type text},
			                {"Why important/What decision does it drive", type text},
			                {"Formula", type text},
			                {"Owner", type text},
			                {"Domain", type text},
			                {"Target", type text},
			                {"Leading/Lagging", type text},
			                {"Direction of good performance", type text},
			                {"Frequency", type text},
			                {"Approval Status", type text},
			                {"Comment", type text},
			                {"Type of KPI", type text},
			                {"Unit of Measure", type text}
			            }
			        )
			in
			    Convert_DataTypes
		lineageTag: 2a501181-92a7-4af8-a1dd-04a4857e8fb5
	
		annotation PBI_NavigationStepName = Navigation

		annotation PBI_ResultType = Table
		

