	/// Staging query for the Calendar dimension. Generates the dates with fn_generate_date_dimension and applies the friendly names.
	expression stg_calendar =
			let
			    // -------------------------------------------------------
			    // Calendar range: 2020-01-01 to the end of next year.
			    // The end date is evaluated at every refresh, so the
			    // calendar never needs a manual update.
			    // -------------------------------------------------------
			    Start_Date = #date(2020, 1, 1),
			    End_Date = Date.EndOfYear(Date.AddYears(Date.From(DateTimeZone.FixedUtcNow()), 1)),
			
			    Source =
			        fn_generate_date_dimension(
			            Start_Date,
			            End_Date,
			            null,       // Fiscal year start month (not used)
			            null,       // Holidays (not used)
			            1,          // Weekday numbering Monday = 1 through Sunday = 7
			            false       // No relative networkdays column
			        ),
			
			    // -------------------------------------------------------
			    // Keep the generated columns the calendar is built from
			    // -------------------------------------------------------
			    Select_Columns =
			        Table.SelectColumns(
			            Source,
			            {
			                "Date", "Year", "CurrYearOffset",
			                "Quarter", "CurrQuarterOffset",
			                "Month", "Start of Month", "End of Month", "MonthnYear", "CurrMonthOffset",
			                "Week Number", "WeeknYear", "CurrWeekOffset",
			                "Day of Month", "Day of Week Number", "CurrDayOffset", "IsWeekDay"
			            }
			        ),
			
			    // -------------------------------------------------------
			    // Text attributes use an explicit culture, so names do not
			    // depend on the locale of the machine or the model
			    // -------------------------------------------------------
			    Add_MonthName = Table.AddColumn(Select_Columns, "Month name", each Date.ToText([Date], [Format = "MMMM", Culture = "en-US"]), type text),
			    Add_MonthShort = Table.AddColumn(Add_MonthName, "Month short", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
			    // Zero-width spaces make the initials unique, so they can sort by month number
			    Add_MonthInitial = Table.AddColumn(Add_MonthShort, "Month initial", each Text.Start([Month name], 1) & Text.Repeat(Character.FromNumber(8203), [Month]), type text),
			    Add_DayOfWeekName = Table.AddColumn(Add_MonthInitial, "Day of week name", each Date.ToText([Date], [Format = "dddd", Culture = "en-US"]), type text),
			    Add_DayOfWeekInitial = Table.AddColumn(Add_DayOfWeekName, "Day of week initial", each Text.Start([Day of week name], 1) & Text.Repeat(Character.FromNumber(8203), [Day of Week Number]), type text),
			    Add_YearQuarter = Table.AddColumn(Add_DayOfWeekInitial, "Year quarter", each Text.From([Year]) & " " & [Quarter], type text),
			    Add_YearMonth = Table.AddColumn(Add_YearQuarter, "Year month", each Text.From([Year]) & " " & [Month short], type text),
			    Add_YearWeek = Table.AddColumn(Add_YearMonth, "Year week", each Text.From(Number.IntegerDivide([WeeknYear], 100)) & " W" & Text.PadStart(Text.From([Week Number]), 2, "0"), type text),
			    Add_YearFlag = Table.AddColumn(Add_YearWeek, "Year flag", each if [CurrYearOffset] = 0 then "Current year" else Text.From([Year]), type text),
			    Add_MonthFlag = Table.AddColumn(Add_YearFlag, "Month flag", each if [CurrMonthOffset] = 0 then "Current month" else [Year month], type text),
			
			    // -------------------------------------------------------
			    // Friendly names from the Group Analytics calendar specification
			    // -------------------------------------------------------
			    Rename_Columns =
			        Table.RenameColumns(
			            Add_MonthFlag,
			            {
			                {"CurrYearOffset", "Current year offset"},
			                {"CurrQuarterOffset", "Current quarter offset"},
			                {"Month", "Month number"},
			                {"Start of Month", "Start of month"},
			                {"End of Month", "End of month"},
			                {"MonthnYear", "Year month number"},
			                {"CurrMonthOffset", "Current month offset"},
			                {"Week Number", "Week number"},
			                {"WeeknYear", "Year week number"},
			                {"CurrWeekOffset", "Current week offset"},
			                {"Day of Month", "Day of month"},
			                {"Day of Week Number", "Day of week number"},
			                {"CurrDayOffset", "Current day offset"},
			                {"IsWeekDay", "Is weekday"}
			            }
			        ),
			
			    Reorder_Columns =
			        Table.ReorderColumns(
			            Rename_Columns,
			            {"Date", "Year", "Current year offset", "Year flag", "Quarter", "Year quarter", "Current quarter offset", "Month number", "Start of month", "End of month", "Month name", "Month short", "Month initial", "Year month", "Year month number", "Current month offset", "Month flag", "Week number", "Year week", "Year week number", "Current week offset", "Day of month", "Day of week number", "Day of week name", "Day of week initial", "Current day offset", "Is weekday"}
			        )
			in
			    Reorder_Columns
		lineageTag: 915a5ba6-12ad-4099-a50f-f09048a7a9e8
		queryGroup: '4. Stage'

		annotation PBI_NavigationStepName = Navigation

		annotation PBI_ResultType = Table

	/// Calendar dimension. One row per date from 2020-01-01 to the end of next year. Offsets and flags are recalculated at every refresh.
	table Calendar
		lineageTag: 6c14c40a-b424-4046-bb21-a21ffd2eb413
		dataCategory: Time

		/// Calendar date. Unique key for the calendar dimension.
		column Date
			dataType: dateTime
			isKey
			formatString: yyyy-mm-dd
			lineageTag: 07274728-f869-419c-b012-69a64310ec68
			summarizeBy: none
			sourceColumn: Date

			annotation SummarizationSetBy = User

			annotation UnderlyingDateTimeDataType = Date

		/// Calendar year, not ISO week-year.
		column Year
			dataType: int64
			formatString: 0
			lineageTag: 7ca3ebf8-9d91-4ecd-8ddd-422d8cbb3702
			summarizeBy: none
			sourceColumn: Year

			annotation SummarizationSetBy = User

		/// Dynamic current-year label: 'Current year' for the current year, otherwise the year. Recalculated at refresh.
		column 'Year flag'
			dataType: string
			lineageTag: 92acb6b0-0475-48b3-b284-6e41eaa6f70d
			summarizeBy: none
			sourceColumn: Year flag
			sortByColumn: 'Current year offset'

			annotation SummarizationSetBy = User

		/// Relative calendar-year offset. Current year = 0, previous year = -1. Recalculated at refresh.
		column 'Current year offset'
			dataType: int64
			formatString: 0
			lineageTag: a3ea31cd-bad1-42e0-a079-0452c8b3b0a3
			summarizeBy: none
			sourceColumn: Current year offset

			annotation SummarizationSetBy = User

		/// Calendar-quarter label, Q1-Q4.
		column Quarter
			dataType: string
			lineageTag: 8d357137-ae04-4926-a000-b16e53d2dea8
			summarizeBy: none
			sourceColumn: Quarter

			annotation SummarizationSetBy = User

		/// Calendar year and quarter label, for example 2026 Q1. Sorts correctly as text.
		column 'Year quarter'
			dataType: string
			lineageTag: ab0ae40a-54cd-4e26-ae5e-5af525a7092b
			summarizeBy: none
			sourceColumn: Year quarter

